{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Character Rig Forge Manifest",
  "type":"object",
  "required":["schemaVersion","source","inference","joints","bones","layers"],
  "properties":{
    "schemaVersion":{"type":"string"},
    "studio":{"type":"string"},
    "source":{"type":"object","required":["name","width","height"]},
    "inference":{"type":"object","required":["subjectModel","poseModel","mode"]},
    "joints":{"type":"object"},
    "bones":{"type":"array"},
    "layers":{"type":"array"}
  }
}
